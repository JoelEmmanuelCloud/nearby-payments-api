load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "Identity",
    srcs = glob(
        [
            "IdentityCore/Sources/Identity/**/*.swift",
        ],
        exclude = [
            "IdentityCore/Sources/Identity/swift-java.config",
        ],
    ),
    module_name = "Identity",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/auth:Auth",
        "//packages/gateway:Gateway",
        "//packages/sui-api:LeanSuiApi",
    ],
)

swift_test(
    name = "IdentityTests",
    srcs = glob([
        "IdentityCore/Tests/IdentityTests/**/*.swift",
    ]),
    deps = [
        ":Identity",
        "//packages/auth:Auth",
        "//packages/gateway:Gateway",
    ],
)
