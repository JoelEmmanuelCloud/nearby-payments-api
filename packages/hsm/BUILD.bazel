load("@rules_jvm_external//:defs.bzl", "artifact")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "HSM",
    srcs = glob(["HSMCore/Sources/HSM/**/*.swift"]),
    module_name = "HSM",
    visibility = ["//visibility:public"],
)

kt_android_library(
    name = "HSMAndroid",
    srcs = glob(["Java/**/*.kt"]),
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
    deps = [
        "//apps/android/bridge:bridge_aar",
        "@maven//:androidx_core_core",
        artifact("org.swift.swiftkit:swiftkit-core"),
    ],
)

swift_test(
    name = "HSMTests",
    srcs = glob(["HSMCore/Tests/HSMTests/**/*.swift"]),
    deps = [":HSM"],
)
