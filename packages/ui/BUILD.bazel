load("@rules_android//rules:rules.bzl", "aar_import")
load("@rules_jvm_external//:defs.bzl", "artifact")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_kotlin//kotlin:core.bzl", "kt_compiler_plugin")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "UI",
    srcs = glob(["Sources/UI/**/*.swift"]),
    module_name = "UI",
    visibility = ["//visibility:public"],
    deps = select({
        # iOS-only, mirroring the SPM `.when(platforms: [.iOS])` condition; macOS `ToastHost` is a
        # passthrough that doesn't import Toasts.
        "@platforms//os:ios": ["@swiftpkg_swiftui_toasts//:Toasts"],
        "//conditions:default": [],
    }),
)

swift_test(
    name = "UITests",
    srcs = glob(["Tests/UITests/**/*.swift"]),
    deps = [":UI"],
)

kt_compiler_plugin(
    name = "compose_compiler_plugin",
    id = "androidx.compose.compiler.plugins.kotlin",
    target_embedded_compiler = True,
    deps = [
        artifact("org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable"),
    ],
)

kt_android_library(
    name = "UIAndroid",
    srcs = glob(["Java/**/*.kt"]),
    custom_package = "com.variance.nearby.ui",
    plugins = [":compose_compiler_plugin"],
    visibility = ["//visibility:public"],
    deps = [
        artifact("androidx.compose.foundation:foundation"),
        artifact("androidx.compose.foundation:foundation-layout"),
        artifact("androidx.compose.material3:material3"),
        artifact("androidx.compose.ui:ui"),
        artifact("androidx.compose.ui:ui-graphics"),
        artifact("androidx.compose.ui:ui-tooling-preview"),
        artifact("androidx.core:core-ktx"),
        artifact("io.github.dokar3:sonner-android"),
    ],
)

aar_import(
    name = "sonner_android_override",
    aar = "@maven//:io/github/dokar3/sonner-android/0.3.9/sonner-android-0.3.9.aar",
    visibility = ["//visibility:public"],
    deps = [
        artifact("androidx.compose.foundation:foundation"),
        "@maven//:org_jetbrains_annotations",
        "@maven//:org_jetbrains_compose_ui_ui_tooling_preview",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
    ],
)
