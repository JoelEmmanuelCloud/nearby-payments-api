{
  "javaPackage": "com.variance.nearby.leansui",
  "mode": "jni",
  "enableJavaCallbacks": true,
  "gradleUserHome": "~/.cache/swift-java/gradle/sui",
  "swiftFilterInclude": [
    "**.ZkLoginSigner",
    "**.ZkLoginAuthenticator",
    "**.zkLoginUtilities",
    "**.ZkProof",
    "**.RemoteZkProofService",
    "**.SuiGraphQLClient",
    "**.TransactionBlock",
    "**.zkLoginPublicIdentifier",
    "**.zkLoginSignature",
    "**.zkLoginSignatureInputs",
    "**.zkLoginSignatureInputsProofPoints",
    "**.zkLoginSignatureInputsClaim",
    "**.Account",
    "**.ED25519PublicKey",
    "**.ED25519PrivateKey",
    "**.HSMPublicKey",
    "**.HSMPrivateKey",
    "**.EpochInfo",
    "**.PublicKeyProtocol",
    "**.PrivateKeyProtocol",
    "**.TransactionArgument",
    "**.TransactionObjectArgument",
    "**.TransactionBlockInput",
    "**.KeyType",
    "**.Signature",
    "**.IntentScope",
    "**.ExportedAccount",
    "**.KeyProtocol",
    "**.EncodingProtocol",
    "**.EncodingContainer",
    "**.SuiBCSBridged",
    "**.ValueType",
    "**.ResultArgument",
    "**.NestedResultArgument",
    "**.SignatureScheme",
    "**.TransactionArgumentName",
    "**.ZkLoginVerifyResult",
    "**.ZkLoginIntentScope"
  ],
  "swiftFilterExclude": [
    "**.Data",
    "**.DataProtocol",
    "**.SuiJsonValue",
    "**.JSON",
    "**.SuiJSON"
  ]
}
