load("@rules_jvm_external//:defs.bzl", "artifact")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "Auth",
    srcs = glob(["AuthCore/Sources/Auth/**/*.swift"]),
    module_name = "Auth",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/gateway:Gateway",
        "//packages/hsm:HSM",
        "//packages/storage:Storage",
        "@swiftpkg_googlesignin_ios//:GoogleSignIn",
        "@swiftpkg_swift_crypto//:Crypto",
    ],
)

kt_android_library(
    name = "AuthAndroid",
    srcs = glob(["Java/**/*.kt"]),
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
    deps = [
        "//apps/android/bridge:bridge_aar",
        "//packages/device-integrity:DeviceIntegrityAndroid",
        "//packages/hsm:HSMAndroid",
        "//packages/storage:StorageAndroid",
        "@maven//:androidx_core_core",
        "@maven//:androidx_credentials_credentials",
        "@maven//:androidx_credentials_credentials_play_services_auth",
        artifact("org.swift.swiftkit:swiftkit-core"),
    ],
)
